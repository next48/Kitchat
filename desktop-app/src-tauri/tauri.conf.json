{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitchat",
  "version": "1.4.92",
  "identifier": "ru.oliverkitchen.community",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kitchat",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundThrottling": "disabled",
        "fullscreen": false
      },
      {
        "label": "tray",
        "title": "Kitchat",
        "url": "tray.html",
        "width": 246,
        "height": 184,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/installer-header.bmp",
        "sidebarImage": "installer/installer-sidebar.bmp",
        "uninstallerHeaderImage": "installer/uninstaller-header.bmp",
        "startMenuFolder": "Kitchat",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2ODQ5OTFFMTQ4RjkwQUIKUldTcmtJOFVIcG1FNW0veG50dXQ4UDhIenVVaWdvb1RJbitFYVdpL2RkdkpBQjloVGRsNXE1S3YK",
      "endpoints": [
        "https://oliverkitchen.ru/downloads/kitchat/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "kitchat"
        ]
      }
    }
  }
}



